# Enter secrets locally. Do not paste tokens into the Telegram channel.
TELEGRAM_BOT_TOKEN=
# Numeric ID of YOUR channel, usually beginning with -100.
TELEGRAM_CHANNEL_ID=
# To use local Ollama without a model API key, copy .env.ollama.example instead.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Required: a model available to your API account supporting image input and
# Responses API strict JSON-schema output. No model is silently chosen for you.
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
DATA_DIR=/data
# Counts uncached requests across retries of the same edition. Not a money cap.
MAX_MODEL_CALLS_PER_EDITION=140
