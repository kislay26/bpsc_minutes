# Local Python setup: copy this file to .env and enter your Telegram values.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Download separately with: ollama pull qwen3-vl:4b-instruct
# Starting point for testing; newspaper accuracy is not yet benchmarked.
OLLAMA_MODEL=qwen3-vl:4b-instruct
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=12000
OLLAMA_TIMEOUT_SECONDS=1200
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
DATA_DIR=./data
MAX_MODEL_CALLS_PER_EDITION=140
# No OPENAI_API_KEY or Ollama cloud key is needed.
# Set OLLAMA_NO_CLOUD=1 in the Ollama server environment, not just this file.
